# CoreFW is its own git repository (anthonyhfm/launchpad-core-firmware; our work is on branch lppmk3-sequencer)
/corefw/
# Renode download (installed at ~/Applications/Renode.app)
/tools/
# Build products
/build/
/app/build/
/app/.build/
.swiftpm/
__pycache__/
# Emulator run output and state
*.log
renode/flash.bin
renode/_*
renode/boot1.txt
renode/stock1.txt
.DS_Store
# Never commit firmware images (Novation firmware must not be redistributed; CoreFW builds belong to CoreFW)
*.syx
*.elf
firmware*.bin
# Generated by app/icon/make_icns.sh (make_app.sh runs it)
app/icon/AppIcon.icns
